{
  "name": "myzilla",
  "version": "0.1.0",
  "description": "Self-hosted personal browsing review",
  "scripts": {
    "dev": "vite",
    "build": "tsc --noEmit && vite build && node scripts/build-extension.mjs && python3 scripts/package-downloads.py",
    "start": "node --env-file-if-exists=.env --import tsx src/index.ts",
    "test": "tsx --test tests/*.test.ts",
    "check": "tsc --noEmit",
    "test:importer": "python3 -m unittest discover -s tests -p '*_test.py'",
    "test:browser": "node tests/browser-smoke.mjs",
    "lint:firefox": "web-ext lint --source-dir dist/firefox --ignore-files downloads",
    "test:firefox": "node tests/firefox-smoke.mjs",
    "ingest": "node --env-file-if-exists=.env --import tsx src/ingest.ts",
    "db:backup": "python3 scripts/backup.py",
    "test:community": "node tests/community-browser.mjs",
    "test:portal": "node tests/portal-browser.mjs"
  },
  "keywords": [],
  "type": "module",
  "devDependencies": {
    "@playwright/test": "^1.63.0",
    "@types/chrome": "^0.3.0",
    "@types/node": "^26.6.3",
    "@types/webextension-polyfill": "^0.12.6",
    "esbuild": "^0.28.2",
    "prettier": "^3.9.9",
    "tsx": "^4.23.15",
    "typescript": "^7.0.2",
    "vite": "^8.3.1",
    "web-ext": "^10.7.0"
  },
  "dependencies": {
    "@hono/node-server": "^2.1.1",
    "hono": "^4.13.9",
    "webextension-polyfill": "^0.12.0",
    "zod": "^4.6.5"
  },
  "private": true,
  "engines": {
    "node": ">=24"
  }
}
