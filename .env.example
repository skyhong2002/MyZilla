HOST=127.0.0.1
PORT=18140
MYZILLA_DB=./data/myzilla.sqlite
# Generate: python3 -c 'import secrets; print(secrets.token_urlsafe(48))'
MYZILLA_TOKEN=replace-with-a-random-token-at-least-32-characters

# Optional Google sign-in; register PUBLIC_ORIGIN/auth/google/callback in Google Cloud.
PUBLIC_ORIGIN=https://myzilla.observe.tw
GOOGLE_CLIENT_ID=
GOOGLE_CLIENT_SECRET=

# AI weekly digest via the sky-mini AI gateway (docs/ai-digest.md). Unset: falls back to local `codex exec`.
MYZILLA_LLM_BASE_URL=http://100.71.224.62:8318/v1
MYZILLA_LLM_API_KEY=
# Gateway aliases; these are the defaults.
# MYZILLA_CLASSIFIER_MODEL=sky-fast
# MYZILLA_INTERPRETER_MODEL=sky-quality
